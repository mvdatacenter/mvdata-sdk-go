#!/bin/bash
# Thin wrapper. Fetches and caches pre-commit.sh from central repo, then runs it.

SCRIPT=".ai-shared/pre-commit.sh"
RAW="https://raw.githubusercontent.com/mvdatacenter/ai-instructions/main/hooks/pre-commit.sh"

if [ ! -f "$SCRIPT" ]; then
    mkdir -p .ai-shared
    TOKEN=$(gh auth token 2>/dev/null)
    # Land the download on a side path first: a transfer that dies mid-stream
    # still writes what it received, and under -o "$SCRIPT" that half-file
    # becomes the cache every later commit runs and no later fetch replaces.
    PARTIAL="$SCRIPT.fetching.$$"
    if curl -sf -H "Authorization: token $TOKEN" "$RAW" -o "$PARTIAL"; then
        mv -f "$PARTIAL" "$SCRIPT"
    else
        rm -f "$PARTIAL"
    fi
fi

if [ ! -f "$SCRIPT" ]; then
    echo "pre-commit: $SCRIPT is missing and could not be fetched from" >&2
    echo "$RAW, so the central checks this commit needs never ran." >&2
    echo "Refusing the commit rather than passing it unchecked. Retry once" >&2
    echo "network or 'gh auth' is available, or run 'bash .githooks/pre-commit'" >&2
    echo "to provision the checkout." >&2
    exit 1
fi

bash "$SCRIPT"
